<?php
/**
 * gitship: GitHub webhook receiver (auto-generated by `repo start`).
 *
 * - Verifies GitHub's HMAC signature (X-Hub-Signature-256) before anything.
 * - Reacts only to push events on the configured branch.
 * - Runs `git fetch` + `git reset --hard FETCH_HEAD` in the project folder.
 * - The secret and paths live in a config file OUTSIDE the web root,
 *   readable only by your cPanel user (mode 600).
 *
 * This file is safe to leave in the web root: it holds no secrets itself.
 */

$confFile = '{{CONF_FILE}}';

if (!is_file($confFile)) {
    http_response_code(500);
    exit('deploy: config missing');
}
$cfg = @parse_ini_file($confFile);
if (!$cfg || empty($cfg['repo_path']) || empty($cfg['branch']) || empty($cfg['secret'])) {
    http_response_code(500);
    exit('deploy: config invalid');
}

$log    = !empty($cfg['log_file'])  ? $cfg['log_file']  : '/dev/null';
$lock   = !empty($cfg['lock_file']) ? $cfg['lock_file'] : sys_get_temp_dir() . '/cpanel-deploy.lock';
$repo   = $cfg['repo_path'];
$branch = $cfg['branch'];

function cpanel_deploy_log($file, $msg) {
    @file_put_contents($file, '[' . date('Y-m-d H:i:s') . '] ' . $msg . "\n", FILE_APPEND | LOCK_EX);
}

// --- 1. signature check -----------------------------------------------------
$raw      = file_get_contents('php://input');
$sig      = isset($_SERVER['HTTP_X_HUB_SIGNATURE_256']) ? $_SERVER['HTTP_X_HUB_SIGNATURE_256'] : '';
$expected = 'sha256=' . hash_hmac('sha256', $raw, $cfg['secret']);
$sigOk    = function_exists('hash_equals')
          ? hash_equals($expected, $sig)
          : strcmp($expected, $sig) === 0;
if ($sig === '' || !$sigOk) {
    http_response_code(403);
    cpanel_deploy_log($log, 'REJECTED bad or missing signature');
    exit('deploy: signature check failed');
}

// --- 2. event filter --------------------------------------------------------
$event = isset($_SERVER['HTTP_X_GITHUB_EVENT']) ? $_SERVER['HTTP_X_GITHUB_EVENT'] : '';
if ($event === 'ping') {
    http_response_code(200);
    exit('deploy: ping ok - webhook is wired correctly');
}
if ($event !== 'push') {
    http_response_code(200);
    exit('deploy: event ignored');
}

// --- 3. branch filter -------------------------------------------------------
$payload = json_decode($raw, true);
$want    = 'refs/heads/' . $branch;
if (!is_array($payload) || !isset($payload['ref']) || $payload['ref'] !== $want) {
    http_response_code(200);
    exit('deploy: push to another branch - ignored');
}

// --- 4. lock (avoid overlapping deploys) ------------------------------------
$fp = @fopen($lock, 'c');
if (!$fp || !flock($fp, LOCK_EX | LOCK_NB)) {
    http_response_code(429);
    exit('deploy: already running');
}

cpanel_deploy_log($log, 'WEBHOOK push received for ' . $want);

// --- 5. deploy --------------------------------------------------------------
$errors = 0;

if (!function_exists('exec')) {
    cpanel_deploy_log($log, 'FATAL: exec() is disabled on this host. Use cron mode instead: run `repo start` and choose cron.');
    flock($fp, LOCK_UN);
    fclose($fp);
    http_response_code(500);
    exit('deploy: exec() disabled - use cron mode');
}

$out = array(); $rc = 1;
exec('cd ' . escapeshellarg($repo) . ' && git fetch origin ' . escapeshellarg($branch) . ' 2>&1', $out, $rc);
cpanel_deploy_log($log, 'fetch rc=' . $rc . ' :: ' . implode(' | ', array_slice($out, -4)));
if ($rc !== 0) { $errors++; }

if ($errors === 0) {
    $out = array(); $rc = 1;
    exec('cd ' . escapeshellarg($repo) . ' && git reset --hard FETCH_HEAD 2>&1', $out, $rc);
    cpanel_deploy_log($log, 'reset rc=' . $rc . ' :: ' . implode(' | ', array_slice($out, -4)));
    if ($rc !== 0) { $errors++; }
}

if ($errors === 0 && !empty($cfg['after_cmd'])) {
    $out = array(); $rc = 1;
    exec('cd ' . escapeshellarg($repo) . ' && ' . $cfg['after_cmd'] . ' 2>&1', $out, $rc);
    cpanel_deploy_log($log, 'after_cmd rc=' . $rc . ' :: ' . implode(' | ', array_slice($out, -6)));
    if ($rc !== 0) { $errors++; }
}

flock($fp, LOCK_UN);
fclose($fp);

if ($errors > 0) {
    cpanel_deploy_log($log, 'DEPLOY FAILED');
    http_response_code(500);
    exit('deploy failed - check the deploy log');
}

cpanel_deploy_log($log, 'DEPLOY OK');
http_response_code(200);
exit('deploy ok');
